Package: LHmom
Title: Parameter Estimation and Total Calculations of Linear Higher-Order Moments (LH-Moments)
Version: 0.0.0.9000
Authors@R: c(
    person("Palakorn", "Seenoi",        email = "palakorns@kku.ac.th",  role = c("aut", "cre")),
    person("Yire", "Shin",              email = "shinyire@daum.net",    role = "aut"),
    person("Jeong-Soo", "Park",         email = "jspark@jnu.ac.kr",     role = "aut"),
    person("Piyapatr", "Busababodhin",  email = "piyapatr.b@msu.ac.th", role = "aut")
